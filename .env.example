# Autonomous AI GitHub Coding Agent Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to source control!

# Groq API Configuration (Required)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Configurable Groq model (e.g., llama-3.3-70b-versatile, llama-3.1-70b-versatile, mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_RETRIES=3

# GitHub Configuration (Required for pushing & PR creation)
# Personal Access Token with 'repo' scope or GitHub Actions GITHUB_TOKEN
GITHUB_TOKEN=your_github_token_here
REPO_OWNER=laxman235
REPO_NAME=AI-GitHub-Coding-Agent
TARGET_BRANCH=develop

# Target Application Path (Absolute or relative to workspace)
# Defaults to the included sample Spring Boot app if not specified
TARGET_REPO_PATH=sample-spring-boot-app

# Agent Execution Limits
MAX_DAILY_TASKS=10
MAX_REPAIR_ATTEMPTS=2
DRY_RUN=false

# SQLite Database Path for Task Persistence
DATABASE_PATH=data/agent_tasks.db

# Reports Output Directory
REPORTS_DIR=reports
